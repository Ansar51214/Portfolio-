<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Al-Falah Artificial Limbs Center - Dr. Asif Ali</title>
    <meta name="description" content="Al-Falah Artificial Limbs Center by Dr. Asif Ali. Prosthetics, orthotics, rehabilitation, and patient-focused mobility care in Muzaffargarh.">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
    
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* ======================== 
           DESIGN SYSTEM & VARIABLES
           ======================== */
        :root {
            --primary-navy: #0a1628;
            --primary-navy-light: #16263e;
            --accent-gold: #c9a84c;
            --accent-gold-hover: #e0be60;
            --text-dark: #2d3748;
            --text-light: #718096;
            --bg-light: #f8fafc;
            --bg-white: #ffffff;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* ======================== 
           GLOBAL STYLES
           ======================== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            color: var(--text-dark);
            background-color: var(--bg-light);
            line-height: 1.6;
            overflow-x: hidden;
        }

        #about,
        #services,
        #technology,
        #testimonials,
        #faq,
        #appointment,
        #contact {
            scroll-margin-top: 88px;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Cormorant Garamond', serif;
            color: var(--primary-navy);
            line-height: 1.2;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        .container {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* ======================== 
           BUTTONS & UTILITIES
           ======================== */
        .btn {
            display: inline-block;
            padding: 1rem 2rem;
            border-radius: 4px;
            font-weight: 500;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: var(--transition);
            border: none;
            font-family: 'DM Sans', sans-serif;
            text-align: center;
        }

        .btn-gold {
            background-color: var(--accent-gold);
            color: var(--primary-navy) !important;
            border: 1px solid var(--accent-gold);
            font-weight: 600;
        }

        .btn-gold:hover {
            background-color: var(--accent-gold-hover);
            border-color: var(--accent-gold-hover);
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(201, 168, 76, 0.4);
        }

        .btn-outline {
            background-color: transparent;
            color: var(--accent-gold);
            border: 1px solid var(--accent-gold);
        }

        .btn-outline:hover {
            background-color: rgba(201, 168, 76, 0.1);
            transform: translateY(-2px);
        }

        .eyebrow {
            color: var(--accent-gold);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 700;
            font-size: 0.9rem;
            margin-bottom: 1rem;
            display: block;
        }

        .section-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .section-header h2 {
            font-size: 3rem;
            margin-bottom: 1rem;
        }

        .section-header p {
            color: var(--text-light);
            max-width: 650px;
            margin: 0 auto;
            font-size: 1.1rem;
        }

        /* Animations */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease-out, transform 0.8s ease-out;
        }

        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* ======================== 
           1. NAVBAR
           ======================== */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            background-color: rgba(10, 22, 40, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1000;
            padding: 1rem 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            transition: var(--transition);
        }

        nav .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--bg-white);
            display: flex;
            align-items: center;
        }

        .logo span {
            color: var(--accent-gold);
            margin-left: 5px;
        }

        .site-logo {
            font-family: 'DM Sans', sans-serif;
            gap: 0.75rem;
        }

        .site-logo span {
            margin-left: 0;
        }

        .logo-mark {
            position: relative;
            width: 58px;
            height: 58px;
            display: grid;
            place-items: center;
            color: var(--bg-white);
        }

        .logo-mark::before {
            content: '';
            position: absolute;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #ef3340;
            top: 3px;
            right: 10px;
        }

        .logo-mark::after {
            content: '';
            position: absolute;
            width: 24px;
            height: 36px;
            border-left: 6px solid #ef3340;
            border-radius: 50%;
            left: 9px;
            top: 17px;
            transform: rotate(28deg);
        }

        .logo-mark i {
            position: relative;
            z-index: 1;
            font-size: 2.15rem;
            transform: rotate(-18deg);
        }

        .logo-copy {
            display: flex;
            flex-direction: column;
            line-height: 1;
        }

        .site-logo .logo-name {
            color: var(--bg-white);
            font-size: 2.1rem;
            font-weight: 700;
            letter-spacing: 1px;
        }

        .site-logo .logo-subtitle {
            color: var(--bg-white);
            font-size: 0.7rem;
            font-weight: 700;
            letter-spacing: 0.6px;
            margin-top: 0.45rem;
        }

        .nav-links {
            display: flex;
            gap: 2.5rem;
            align-items: center;
        }

        .nav-links a {
            color: var(--bg-white);
            font-size: 0.95rem;
            font-weight: 500;
            transition: var(--transition);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .nav-links a:hover {
            color: var(--accent-gold);
        }

        .hamburger {
            display: none;
            cursor: pointer;
            background: none;
            border: none;
            color: var(--accent-gold);
            font-size: 1.5rem;
        }

        /* ======================== 
           2. HERO SECTION
           ======================== */
        #home {
            background:
                radial-gradient(circle at 72% 38%, rgba(31, 78, 122, 0.32), rgba(10,22,40,0) 33%),
                linear-gradient(135deg, #021426 0%, #062140 48%, #031326 100%);
            min-height: 100vh;
            display: block;
            padding: 8.5rem 0 1.8rem;
            position: relative;
            overflow: hidden;
        }

        #home .container {
            max-width: 1440px;
        }

        #home::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                linear-gradient(90deg, rgba(2,20,38,0.92) 0%, rgba(2,20,38,0.82) 45%, rgba(2,20,38,0.26) 70%, rgba(2,20,38,0.1) 100%),
                radial-gradient(circle at 8% 80%, rgba(201,168,76,0.1), transparent 22%);
            z-index: 0;
        }

        .hero-content {
            display: grid;
            grid-template-columns: minmax(610px, 0.95fr) minmax(660px, 1.05fr);
            gap: 2rem;
            align-items: center;
            position: relative;
            z-index: 1;
        }

        .hero-text {
            max-width: 700px;
        }

        .hero-text .eyebrow {
            color: var(--accent-gold);
            font-size: 1.05rem;
            letter-spacing: 4px;
            margin-bottom: 1.5rem;
        }

        .hero-text h1 {
            color: var(--bg-white);
            font-size: clamp(3.6rem, 5.35vw, 5rem);
            margin-bottom: 1.8rem;
            line-height: 1.05;
            letter-spacing: 0;
        }

        .hero-text h1 i {
            color: var(--accent-gold);
            font-style: italic;
            font-weight: 400;
        }

        .hero-text p {
            color: #cbd5e1;
            font-size: 1.12rem;
            margin-bottom: 2.2rem;
            max-width: 560px;
            line-height: 1.75;
            position: relative;
            padding-top: 1.65rem;
        }

        .hero-text p::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 78px;
            height: 3px;
            background: var(--accent-gold);
        }

        .hero-buttons {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            flex-wrap: wrap;
        }

        .hero-buttons .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
            min-width: 210px;
            padding: 1.05rem 1.6rem;
        }

        .hero-feature-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(92px, 1fr));
            gap: 1.35rem;
            margin-top: 1.8rem;
            max-width: 590px;
        }

        .hero-feature {
            color: var(--bg-white);
            text-align: center;
            font-size: 0.95rem;
            line-height: 1.35;
        }

        .hero-feature i {
            width: 78px;
            height: 78px;
            margin: 0 auto 0.7rem;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: rgba(23, 63, 109, 0.58);
            border: 1px solid rgba(255,255,255,0.06);
            color: var(--bg-white);
            font-size: 2rem;
            box-shadow: inset 0 0 25px rgba(255,255,255,0.04);
        }

        .hero-image {
            position: relative;
            min-height: 650px;
            align-self: stretch;
            display: flex;
            align-items: flex-start;
            justify-content: flex-end;
            margin-right: -2rem;
        }

        .hero-image::before {
            content: '';
            position: absolute;
            left: 2.5rem;
            top: 0;
            bottom: 0;
            width: 1px;
            background: rgba(255,255,255,0.42);
            transform: skewX(-18deg);
            z-index: 2;
            pointer-events: none;
        }

        .hero-image img {
            width: 100%;
            height: min(74vh, 760px);
            min-height: 640px;
            object-fit: cover;
            object-position: center;
            border-radius: 18px 0 0 8px;
            clip-path: polygon(14% 0, 100% 0, 100% 100%, 13% 100%, 0 58%);
            box-shadow: -28px 30px 70px rgba(0,0,0,0.32);
            display: block;
        }

        .hero-trust-panel {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 0;
            margin-top: 0;
            background: rgba(9, 35, 65, 0.92);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 8px;
            box-shadow: 0 20px 45px rgba(0,0,0,0.22);
            overflow: hidden;
            backdrop-filter: blur(10px);
        }

        .hero-trust-item {
            display: flex;
            align-items: center;
            gap: 1.25rem;
            padding: 1.45rem 1.8rem;
            color: var(--bg-white);
        }

        .hero-trust-item + .hero-trust-item {
            border-left: 1px solid rgba(255,255,255,0.12);
        }

        .hero-trust-item i {
            width: 54px;
            height: 54px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.55);
            display: grid;
            place-items: center;
            font-size: 1.55rem;
            color: var(--accent-gold);
        }

        .hero-trust-item h5 {
            color: var(--bg-white);
            font-family: 'DM Sans', sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 0.2rem;
        }

        .hero-trust-item p {
            color: #cbd5e1;
            margin: 0;
            font-size: 0.9rem;
        }

        /* ======================== 
           3. TRUST BAR
           ======================== */
        .trust-bar {
            background-color: var(--bg-white);
            padding: 2.5rem 0;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .trust-bar .container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 2rem;
        }

        .trust-badge {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .trust-badge i {
            font-size: 2rem;
            color: var(--accent-gold);
        }

        .trust-badge span {
            font-weight: 600;
            color: var(--primary-navy);
            font-size: 1.1rem;
        }

        /* ======================== 
           4. ABOUT SECTION
           ======================== */
        #about {
            padding: 8rem 0;
        }

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5rem;
            align-items: center;
        }

        .about-image {
            position: relative;
            perspective: 1200px;
        }

        .doctor-portrait-3d {
            --portrait-offset: 1.25rem;
            position: relative;
            isolation: isolate;
            max-width: 520px;
            margin: 0 auto;
            padding: var(--portrait-offset);
            transform-style: preserve-3d;
            transform: rotateY(-7deg) rotateX(3deg);
            transition: var(--transition);
        }

        .doctor-portrait-3d:hover {
            transform: rotateY(-3deg) rotateX(1deg) translateY(-8px);
        }

        .doctor-portrait-3d::before,
        .doctor-portrait-3d::after {
            content: '';
            position: absolute;
            border-radius: 8px;
            z-index: -1;
        }

        .doctor-portrait-3d::before {
            inset: 0.55rem 0.1rem 1.9rem 2.15rem;
            background: linear-gradient(135deg, var(--primary-navy), var(--primary-navy-light));
            box-shadow: 0 28px 65px rgba(10, 22, 40, 0.24);
            transform: translateZ(-42px);
        }

        .doctor-portrait-3d::after {
            inset: 2.15rem 2.15rem 0.1rem 0.1rem;
            border: 2px solid var(--accent-gold);
            transform: translateZ(-20px);
        }

        .doctor-portrait-frame {
            position: relative;
            overflow: hidden;
            border-radius: 8px;
            background: var(--bg-white);
            box-shadow: 0 30px 70px rgba(10, 22, 40, 0.2);
        }

        .doctor-portrait-frame::after {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: 8px;
            border: 1px solid rgba(255,255,255,0.72);
            pointer-events: none;
        }

        .doctor-portrait-frame img {
            width: 100%;
            aspect-ratio: 4 / 5;
            object-fit: cover;
            object-position: center top;
            display: block;
        }

        .doctor-portrait-caption {
            position: absolute;
            left: var(--portrait-offset);
            right: var(--portrait-offset);
            bottom: var(--portrait-offset);
            z-index: 2;
            padding: 1.2rem 1.35rem;
            color: var(--bg-white);
            background: linear-gradient(180deg, rgba(10,22,40,0) 0%, rgba(10,22,40,0.92) 100%);
            border-radius: 0 0 8px 8px;
        }

        .doctor-portrait-caption strong {
            display: block;
            font-size: 1.15rem;
            letter-spacing: 0.3px;
        }

        .doctor-portrait-caption span {
            color: var(--accent-gold);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            font-weight: 700;
        }

        .doctor-portrait-badge {
            position: absolute;
            right: -0.35rem;
            top: 2rem;
            display: inline-flex;
            align-items: center;
            gap: 0.65rem;
            padding: 0.8rem 1rem;
            border-radius: 8px;
            background: var(--bg-white);
            box-shadow: 0 16px 35px rgba(10, 22, 40, 0.16);
            color: var(--primary-navy);
            font-weight: 700;
            transform: translateZ(38px);
            border-left: 4px solid var(--accent-gold);
        }

        .doctor-portrait-badge i {
            color: var(--accent-gold);
            font-size: 1.15rem;
        }

        .about-text h2 {
            font-size: 3rem;
            margin-bottom: 1.5rem;
        }

        .about-text p {
            margin-bottom: 1.5rem;
            font-size: 1.1rem;
            color: var(--text-dark);
        }

        .qualifications-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-top: 2.5rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(0,0,0,0.1);
        }

        .qual-item {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }

        .qual-item i {
            color: var(--accent-gold);
            font-size: 1.4rem;
            margin-top: 0.2rem;
        }

        .qual-item h5 {
            font-family: 'DM Sans', sans-serif;
            font-size: 1.05rem;
            margin-bottom: 0.2rem;
            color: var(--primary-navy);
        }

        .qual-item p {
            font-size: 0.9rem;
            color: var(--text-light);
            margin: 0;
        }

        /* ======================== 
           5. SERVICES SECTION
           ======================== */
        #services {
            padding: 8rem 0;
            background-color: var(--bg-white);
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 2rem;
        }

        .service-card {
            background: var(--bg-light);
            padding: 3rem 2.5rem;
            border-radius: 8px;
            transition: var(--transition);
            border: 1px solid rgba(0,0,0,0.03);
        }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08);
            border-bottom: 3px solid var(--accent-gold);
            background: var(--bg-white);
        }

        .service-icon {
            width: 70px;
            height: 70px;
            background: rgba(201, 168, 76, 0.1);
            color: var(--accent-gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 1.5rem;
            transition: var(--transition);
        }

        .service-card:hover .service-icon {
            background: var(--accent-gold);
            color: var(--bg-white);
        }

        .service-card h3 {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.8rem;
            margin-bottom: 1rem;
        }

        .service-card p {
            color: var(--text-light);
            margin-bottom: 2rem;
            font-size: 1rem;
        }

        .service-link {
            color: var(--accent-gold);
            font-weight: 600;
            font-size: 0.95rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .service-link i {
            transition: transform 0.3s ease;
        }

        .service-link:hover i {
            transform: translateX(5px);
        }

        /* ======================== 
           6. TECHNOLOGY SECTION
           ======================== */
        #technology {
            padding: 8rem 0;
            background-color: var(--primary-navy);
            color: var(--bg-white);
        }

        #technology h2, #technology .section-header p {
            color: var(--bg-white);
        }

        .tech-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5rem;
            align-items: center;
        }

        .tech-image img {
            width: 100%;
            border-radius: 8px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
        }

        .tech-features {
            display: flex;
            flex-direction: column;
            gap: 2.5rem;
        }

        .tech-feature h4 {
            color: var(--accent-gold);
            font-family: 'DM Sans', sans-serif;
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .tech-feature h4::before {
            content: '';
            width: 30px;
            height: 2px;
            background-color: var(--accent-gold);
            display: inline-block;
        }

        .tech-feature p {
            color: #cbd5e1;
            padding-left: 40px;
        }

        /* ======================== 
           7. TESTIMONIALS SECTION
           ======================== */
        #testimonials {
            padding: 8rem 0;
            background-color: var(--bg-light);
        }

        .test-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2.5rem;
        }

        .test-card {
            background: var(--bg-white);
            padding: 3rem 2.5rem;
            border-radius: 8px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.03);
            position: relative;
            transition: var(--transition);
        }

        .test-card:hover {
            box-shadow: 0 15px 40px rgba(0,0,0,0.06);
            transform: translateY(-5px);
        }

        .test-card i.fa-quote-left {
            font-size: 3rem;
            color: rgba(201, 168, 76, 0.15);
            position: absolute;
            top: 2.5rem;
            right: 2.5rem;
        }

        .test-card p.quote {
            font-size: 1.1rem;
            font-style: italic;
            margin-bottom: 2rem;
            position: relative;
            z-index: 1;
            line-height: 1.8;
            color: var(--text-dark);
        }

        .test-author {
            display: flex;
            align-items: center;
            gap: 1rem;
            border-top: 1px solid rgba(0,0,0,0.05);
            padding-top: 1.5rem;
        }

        .test-author img {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--accent-gold);
        }

        .test-author h5 {
            font-family: 'DM Sans', sans-serif;
            font-size: 1.1rem;
            margin-bottom: 0.1rem;
        }

        .test-author span {
            font-size: 0.85rem;
            color: var(--accent-gold);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }

        /* ======================== 
           8. FAQ ACCORDION
           ======================== */
        #faq {
            padding: 8rem 0;
            background-color: var(--bg-white);
